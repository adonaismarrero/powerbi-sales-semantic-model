model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["SourceMode","SampleDataPath","BigQueryProject","BigQueryDataset","LoadMart","Sales","Customers","Products","Date","Security","_Measures"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table _Measures
ref table Sales
ref table Customers
ref table Products
ref table Date
ref table 'Time Intelligence'
ref table Security

ref role 'Regional Manager'

