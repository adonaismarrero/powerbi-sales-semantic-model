/// Dynamic RLS: each manager only sees the customers (and therefore the sales) of their regions.
role 'Regional Manager'
	modelPermission: read

	tablePermission Customers =
			Customers[Region]
			    IN CALCULATETABLE (
			        VALUES ( Security[Region] ),
			        Security[User Email] = USERPRINCIPALNAME ()
			    )

	annotation PBI_Id = 746ce4c9c8a445a8a2feb5d981d3f14a

